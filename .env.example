# Tuck Advisors — environment template. Copy to .env (never commit .env).
# Unset integrations fall back to clearly labelled mock providers in development, or are disabled.

# ---------------------------------------------------------------- core
NODE_ENV=development
APP_URL=http://localhost:3000                # public base URL (unsubscribe links, CORS/CSRF origin)
SESSION_SECRET=                              # REQUIRED in production, >= 32 random chars (HMAC for sessions & extension tokens)
PUBLIC_ORG_SLUG=tuck-advisors                # organisation that owns public analyzer results, leads & subscribers

# ---------------------------------------------------------------- database
DATABASE_URL=                                # Postgres (Supabase / Cloud SQL). Empty => embedded PGlite (local dev only)
DATABASE_POOL_MAX=10
AUTO_MIGRATE=false                           # true => run supabase/migrations on boot (web + worker)
PGLITE_DIR=                                  # embedded DB directory (default ./.data/pglite)
ALLOW_EMBEDDED_DB=false                      # allow PGlite when NODE_ENV=production (demos only)
SEED_PASSWORD=                               # local only: seeds demo org + owner@/admin@/analyst@/viewer@tuck.example

# ---------------------------------------------------------------- jobs
WORKER_INLINE=false                          # run queues inside the web process (always on when using PGlite)
WORKER_INTERVAL_MS=5000                      # apps/workers poll interval
CRON_SECRET=                                 # bearer token for GET /api/internal/cron (Vercel Cron)

# ---------------------------------------------------------------- auth (optional Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Chrome extension
EXTENSION_IDS=                               # comma-separated allowed extension ids for CORS (required in production)

# ---------------------------------------------------------------- AI & research
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
EXA_API_KEY=
SCORING_SERVICE_URL=http://127.0.0.1:8088    # Python Fit Score service (services/ai-research)
SCORING_SERVICE_TOKEN=                       # shared bearer token between web app and scoring service

# ---------------------------------------------------------------- enrichment
APOLLO_API_KEY=
ROCKETREACH_API_KEY=

# ---------------------------------------------------------------- CRM
PIPELINE_CRM_API_KEY=
PIPELINE_CRM_APP_KEY=
PIPELINE_CRM_BASE_URL=                       # default https://api.pipelinecrm.com/api/v3
PIPELINE_CRM_FIT_SCORE_FIELD=                # account-specific custom field id, e.g. custom_label_123
PIPELINE_CRM_FIT_GRADE_FIELD=

# ---------------------------------------------------------------- email & webhooks
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                       # whsec_… from the Resend dashboard
NEWSLETTER_FROM=                             # e.g. Tuck Advisors <insights@yourdomain.com>
WEBHOOK_SIGNING_SECRET=                      # HMAC secret for Zapier / Apps Script webhooks (in & out)
INTEGRATION_ENCRYPTION_KEY=                  # 32-byte base64 key for AES-256-GCM credential storage

# ---------------------------------------------------------------- Google (Gmail / Docs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- Reddit Data API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:tuck-advisors-research:0.1 (by /u/your-account)

# Allow mock AI/email providers when NODE_ENV=production (demos / e2e only; never in a real deployment)
ALLOW_MOCK_PROVIDERS=
ALLOW_DEMO_SEED=
